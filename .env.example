# NeverShort environment. Copy to .env and fill in. Never commit .env.
# Every key is listed here (AGENTS.md section 9). No real values in this file.

# --- Database: Supabase Postgres ---------------------------------------------------------
# App at runtime: the pooled connection (Supabase > Connect > Transaction pooler, port 6543).
DATABASE_URL=
# Prisma migrations: the Session pooler (port 5432), or the Direct connection if your network has IPv6.
DIRECT_URL=

# --- Demo ------------------------------------------------------------------------------------
# The fixed "today" for the demo story (Thu 5 Nov 2026).
DEMO_TODAY=2026-11-05
# Public base URL: PayPal return/cancel URLs and reminder links.
# Locally: http://localhost:3000. On Render: https://<your-service>.onrender.com (fill in once the Render link exists).
APP_URL=http://localhost:3000

# --- PayPal sandbox (Person 2) ---------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for APP_URL/api/paypal/webhook in the PayPal developer dashboard.
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Same value as PAYPAL_CLIENT_ID, for the store page's PayPal button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "1" only in tests: fake PayPal for the e2e test. Refused in production.
PAYPAL_FAKE=

# --- AI (Person 4) ---------------------------------------------------------------------------
# A Gemini model id with tool calling and structured output. Default: gemini-3.5-flash.
# Leave AI_MODEL or the key empty and every AI feature uses its plain fallback.
AI_MODEL=gemini-3.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
# Only if we switch provider to OpenRouter.
OPENROUTER_API_KEY=
