// tmrw database schema.
//
// Rules (AGENTS.md section 9):
// - Every table carries a storeId. Each visitor has their own copy of the demo store, and
//   deleting a Store row deletes the whole copy (onDelete: Cascade).
// - Money is integer cents (Int). Business dates are 'YYYY-MM-DD' strings in the store's time zone.
// - Timestamps (DateTime) are for audit trails only.
// Connection URLs live in prisma.config.ts (CLI) and lib/shared/db.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Store (one row per visitor copy)
// ---------------------------------------------------------------------------

model Store {
  id                      String                @id // 'st_' + 12 chars; this is the storeId
  name                    String
  currency                String                @default("USD")
  timezone                String                @default("America/New_York")
  minimumBalanceCents     Int
  tightMarginCents        Int
  openingBalanceCents     Int // balance at the start of openingBalanceOn
  openingBalanceOn        String // 'YYYY-MM-DD', first day of the simulated history
  openingBalanceSource    String                @default("USER")
  openingBalanceUpdatedAt DateTime?
  whatYouSell             String
  supplierPaymentMethod   SupplierPaymentMethod @default(PAYPAL_PAYOUTS)
  busySeasons             String[]
  focusLine               String? // the month's focus, in one line: "Second oven before Christmas"
  busyDays                String[]              @default([]) // "Sat", "Sun": the owner's busiest days (setup)
  businessType            String? // "Bakery and café" (setup)
  briefTime               String? // 'HH:MM', 24-hour: when the daily brief arrives
  briefChannels           String[]              @default([]) // "In the app", "Notification", "WhatsApp", "Email"
  demoRunId               String // changes on every reset; part of every idempotency key
  isDemo                  Boolean               @default(false)
  createdAt               DateTime              @default(now())
  lastResetAt             DateTime              @default(now())
  lastSeenAt              DateTime              @default(now())

  products      Product[]
  customers     Customer[]
  orders        Order[]
  orderItems    OrderItem[]
  ledgerEntries LedgerEntry[]
  payees        Payee[]
  dues          Due[]
  proposals     Proposal[]
  receipts      Receipt[]
  receiptEvents ReceiptEvent[]
  outbox        OutboxMessage[]
  setAsides     SetAside[]
  gapLoans      GapLoan[]
  riskFlags     RiskFlag[]
  webhookEvents WebhookEvent[]
  payments      PaymentAttempt[]
  memberships   UserStore[]
  auditEvents   FinancialAuditEvent[]
  goals         Goal[]
  requests      TeamRequest[]
  planChanges   PlanChange[]
  team          TeamMember[]
  clients       Client[]
  manualEntries ManualEntry[]

  @@index([lastSeenAt])
}

// ---------------------------------------------------------------------------
// Authentication & User Identity (Multi-tenant SaaS)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  memberships        UserStore[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]

  @@index([email])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum StoreRole {
  OWNER
  MANAGER
  VIEWER
}

model UserStore {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      StoreRole @default(OWNER)
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

enum SupplierPaymentMethod {
  PAYPAL_PAYOUTS
  BANK_TRANSFER
  CARD
}

// ---------------------------------------------------------------------------
// Catalogue, customers, orders
// ---------------------------------------------------------------------------

model Product {
  id          String  @id
  storeId     String
  sku         String
  name        String
  description String
  priceCents  Int
  costCents   Int
  active      Boolean @default(true)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@index([storeId])
}

model Customer {
  id             String  @id
  storeId        String
  name           String
  email          String
  contactConsent Boolean // Guard rule 2: only contact customers who allowed it
  firstSeenOn    String // 'YYYY-MM-DD'

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([storeId])
}

enum OrderStatus {
  ABANDONED // checkout started, never paid
  FAILED // payment attempt failed
  PENDING // approved, waiting for capture: counts as expected money
  CAPTURED // paid
  REFUNDED
}

model Order {
  id              String      @id
  storeId         String
  number          Int // shown to people: "Order #1042"
  customerId      String
  status          OrderStatus
  placedOn        String // 'YYYY-MM-DD'
  placedAt        DateTime
  totalCents      Int
  feeCents        Int? // PayPal fee, once captured
  netCents        Int? // what actually arrived, once captured
  failedAttempts  Int         @default(0)
  dueOn           String? // 'YYYY-MM-DD': when an unpaid order (an invoice) is due
  riskHold        Boolean     @default(false)
  paypalOrderId   String?
  paypalCaptureId String?
  simulated       Boolean     @default(false)

  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  riskFlags     RiskFlag[]
  outbox        OutboxMessage[]
  payments      PaymentAttempt[]

  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([storeId, placedOn])
}

model OrderItem {
  id             String @id
  storeId        String
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Money that already moved (history) and money that will move (dues)
// ---------------------------------------------------------------------------

enum Direction {
  IN
  OUT
}

enum LedgerCategory {
  SALE // net of PayPal fee
  SUPPLIER
  BILL
  OWNER_TRANSFER // owner's transfer from PayPal to their bank
  LOAN_REPAYMENT
  REFUND
  GAP_LOAN // simulated
}

model LedgerEntry {
  id           String         @id
  storeId      String
  occurredOn   String // 'YYYY-MM-DD'
  direction    Direction
  amountCents  Int // always positive; direction gives the sign
  category     LedgerCategory
  description  String
  payeeId      String?
  orderId      String?
  paypalRef    String?
  simulated    Boolean        @default(false)
  // Provenance: USER (typed by owner), IMPORT (CSV/file), PROVIDER (PayPal etc.), FORECAST (estimated), SIMULATED
  source       String         @default("USER")
  sourceDetail String? // file name, provider ref, or human note
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payee Payee? @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredOn])
  @@index([storeId, source])
}

enum PayeeKind {
  SUPPLIER
  BILL
  OWNER_TRANSFER
  LOAN
}

enum PayeeStatus {
  DETECTED // found from history; the owner has not confirmed yet
  CONFIRMED
  DISMISSED
}

enum Cadence {
  EVERY_N_DAYS
  MONTHLY
  EVERY_N_WEEKS
}

model Payee {
  id                 String      @id
  storeId            String
  name               String
  label              String // how it reads in a sentence: "the supplier order", "rent"
  kind               PayeeKind
  status             PayeeStatus
  typicalAmountCents Int
  cadence            Cadence
  intervalDays       Int? // EVERY_N_DAYS
  intervalWeeks      Int? // EVERY_N_WEEKS
  weekday            Int? // EVERY_N_WEEKS: 0 = Sunday
  dayOfMonth         Int? // MONTHLY
  paypalEmail        String? // for Payouts (PAY_SUPPLIER)
  autoDebit          Boolean     @default(false) // taken automatically (a mandate), labelled "Auto-debit"
  canMove            Boolean     @default(false) // the owner said its date can move (setup)
  optional           Boolean     @default(false) // the owner said it can wait (not a must-pay)
  source             String      @default("USER")
  sourceDetail       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dues          Due[]
  ledgerEntries LedgerEntry[]

  @@index([storeId])
  @@index([storeId, source])
}

enum DueStatus {
  SCHEDULED
  PAID
  MOVED
  CANCELLED
}

model Due {
  id           String    @id
  storeId      String
  payeeId      String
  dueOn        String // 'YYYY-MM-DD'
  amountCents  Int
  status       DueStatus @default(SCHEDULED)
  movedFromOn  String? // set when a MOVE_PAYMENT ran (simulated)
  simulated    Boolean   @default(false)
  source       String    @default("USER")
  sourceDetail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payee Payee @relation(fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([storeId, dueOn])
  @@index([storeId, source])
}

// ---------------------------------------------------------------------------
// Proposals, Guard receipts (append-only) and what the executor did
// ---------------------------------------------------------------------------

enum ActionType {
  SEND_REMINDER
  SET_ASIDE
  MOVE_PAYMENT
  GAP_LOAN
  PAY_SUPPLIER
  REFUND
  HOLD_ORDER
}

enum ProposalStatus {
  PROPOSED
  APPROVED
  ESCALATED
  BLOCKED
  OWNER_APPROVED
  OWNER_REJECTED
  EXECUTED
  FAILED
}

model Proposal {
  id             String         @id @default(cuid())
  storeId        String
  type           ActionType
  targetKind     String // ORDER | DUE | PAYEE | STORE
  targetId       String
  targetLabel    String
  amountCents    Int
  params         Json // ActionParamsMap[type] from types/
  proposedBy     String // "OWNER" or "AGENT:RECOVERY" etc.
  idempotencyKey String         @unique // <demo run id>:<action type>:<target id>:<sequence>
  sequence       Int
  draftText      String?
  status         ProposalStatus @default(PROPOSED)
  demoDate       String
  createdAt      DateTime       @default(now())

  store    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  receipts Receipt[]
  outbox   OutboxMessage[]
  setAside SetAside[]
  gapLoan  GapLoan[]

  @@index([storeId, status])
}

enum Decision {
  APPROVE
  ESCALATE
  BLOCK
}

model Receipt {
  id               String   @id @default(cuid())
  storeId          String
  number           Int // receipt No. shown on the thermal receipt
  proposalId       String
  decision         Decision
  headlineRule     String?
  headlineReason   String
  rules            Json // RuleResult[]: all 8 rules with PASS / FAIL / N/A and a reason
  paypalIdsChecked String[]
  demoDate         String
  createdAt        DateTime @default(now())

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proposal Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  events   ReceiptEvent[]

  @@unique([storeId, number])
  @@index([storeId, createdAt])
}

model ReceiptEvent {
  id        String   @id @default(cuid())
  storeId   String
  receiptId String
  kind      String // DECIDED | OWNER_APPROVED | OWNER_REJECTED | RECHECK_BLOCKED | EXECUTED | EXECUTION_FAILED
  detail    String
  paypalIds String[]
  demoDate  String
  createdAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([storeId, receiptId])
}

model OutboxMessage {
  id            String   @id @default(cuid())
  storeId       String
  proposalId    String
  orderId       String
  to            String
  subject       String
  body          String
  checkoutUrl   String
  paypalOrderId String?
  simulated     Boolean  @default(true) // reminders are never really emailed
  sentAt        DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model SetAside {
  id               String   @id @default(cuid())
  storeId          String
  proposalId       String
  dailyAmountCents Int
  startOn          String
  endOn            String
  forDate          String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model GapLoan {
  id          String   @id @default(cuid())
  storeId     String
  proposalId  String
  amountCents Int
  feeCents    Int
  receivedOn  String
  repayOn     String
  simulated   Boolean  @default(true) // gap loans are always simulated
  createdAt   DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Risk and PayPal webhooks
// ---------------------------------------------------------------------------

enum RiskFlagKind {
  UNUSUAL_AMOUNT
  NEW_BUYER_BIG_ORDER
  REPEATED_FAILED_ATTEMPTS
}

model RiskFlag {
  id        String       @id @default(cuid())
  storeId   String
  orderId   String
  kind      RiskFlagKind
  detail    String
  createdAt DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

enum PaymentAttemptStatus {
  CREATED // PayPal order made; the buyer hasn't approved it
  APPROVED // the buyer approved it; not captured yet
  CAPTURED // paid: gross, fee and net are filled in
  DENIED // PayPal denied the capture
  CANCELLED // the buyer cancelled at PayPal
  REFUNDED
}

/// One PayPal checkout for an order. An order can have several (the store checkout, then a fresh link in each
/// reminder), so webhooks find the right order from the PayPal order id.
model PaymentAttempt {
  id              String               @id
  storeId         String
  orderId         String
  paypalOrderId   String               @unique
  source          String // STORE (the buyer's own checkout) | REMINDER (a link in a reminder)
  status          PaymentAttemptStatus @default(CREATED)
  paypalCaptureId String?
  grossCents      Int?
  feeCents        Int? // PayPal's fee, from the capture
  netCents        Int? // what actually arrived
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, orderId])
  @@index([paypalCaptureId])
}

model WebhookEvent {
  id         String   @id // PayPal's event id: a repeat delivery is ignored
  storeId    String // from the order's custom_id; events for unknown stores are not stored
  eventType  String
  resourceId String
  receivedAt DateTime @default(now())
  payload    Json

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Email verification and password reset tokens
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit trail for critical financial changes
// ---------------------------------------------------------------------------

model FinancialAuditEvent {
  id         String   @id @default(cuid())
  storeId    String
  entityType String
  entityId   String
  action     String
  actor      String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// ---------------------------------------------------------------------------
// The month page: goals (Want to do), team requests, and the assistant's proposed changes
// ---------------------------------------------------------------------------

enum GoalStatus {
  PLANNED // on the month page as a want-to-do
  DONE // bought
  DROPPED // the owner took it off
}

model Goal {
  id          String     @id
  storeId     String
  title       String // "Second oven"
  amountCents Int
  savedCents  Int        @default(0) // already put aside for it (part of the PayPal balance)
  wantedOn    String? // 'YYYY-MM-DD': the day the owner would like to buy it
  status      GoalStatus @default(PLANNED)
  source      String     @default("USER") // USER, REQUEST, ASSISTANT
  createdAt   DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

enum RequestStatus {
  OPEN
  ADDED // turned into a goal
  DISMISSED
}

/// Staff and suppliers ask for things here instead of on WhatsApp.
model TeamRequest {
  id         String        @id
  storeId    String
  fromName   String // "Flo"
  fromRole   String // "Baker", "Supplier"
  text       String // their words, as data, never instructions
  topic      String? // grouping key: "mixer"
  receivedOn String // 'YYYY-MM-DD'
  status     RequestStatus @default(OPEN)
  goalId     String?
  createdAt  DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
}

enum PlanChangeKind {
  ADD_PAYMENT // a new must-pay (a bill read from a photo)
  ADD_GOAL // a new want-to-do
  MOVE_GOAL // a want-to-do to another date
}

enum PlanChangeStatus {
  PROPOSED // shown dashed on the month page
  KEPT
  DISCARDED
}

/// One change the assistant proposes. Changes from one instruction share a batchId; the owner keeps or discards them.
model PlanChange {
  id          String           @id
  storeId     String
  batchId     String
  kind        PlanChangeKind
  title       String // "Bean There beans"
  amountCents Int?
  date        String? // 'YYYY-MM-DD'
  fromDate    String? // MOVE_GOAL: where it was
  payeeId     String? // ADD_PAYMENT to a known payee
  goalId      String? // MOVE_GOAL
  note        String? // "read from the photo"
  status      PlanChangeStatus @default(PROPOSED)
  createdAt   DateTime         @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, batchId])
}

// ---------------------------------------------------------------------------
// Setup answers: the team, clients who pay later, and money outside PayPal
// ---------------------------------------------------------------------------

/// Someone who works in the shop. Invited on WhatsApp; only the owner approves money.
model TeamMember {
  id        String   @id
  storeId   String
  name      String
  role      String
  phone     String? // WhatsApp number, as typed
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// A client who buys on credit or invoice, and how tmrw may remind them.
model Client {
  id        String   @id
  storeId   String
  name      String // "Ivory & Vow - wedding planner"
  note      String // "usually pays 5 days late"
  reminders Boolean  @default(true) // the client agreed to reminders
  tone      String   @default("Gentle") // Gentle or Firm
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

enum EntryKind {
  EXPENSE
  REVENUE
}

/// Money the shop pays or receives outside PayPal (cash, bank auto-debits), added by hand in setup.
model ManualEntry {
  id          String    @id
  storeId     String
  name        String // "Oat of Office - oat milk"
  detail      String // "$180 - bank auto-debit on the 15th"
  kind        EntryKind
  amountCents Int? // read from the detail when it has an amount
  createdAt   DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}
